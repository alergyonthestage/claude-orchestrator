#!/usr/bin/env bash
# bin/test — pure bash test runner for claude-orchestrator
# Usage: bin/test [--file <name>] [--filter <substr>] [--verbose] [--list]
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TESTS_DIR="$REPO_ROOT/tests"
export REPO_ROOT

# Skip Docker build in cco init — integration tests don't need the image
export CCO_SKIP_BUILD=1

# Make the suite HERMETIC to interactivity. A cco prompt writes to stdout/stderr
# and reads /dev/tty; when the runner CAPTURES a command's output (`output=$(( fn )
# 2>&1)` in _run_test, and the nested `$()` in run_cco), the prompt text is
# swallowed while the read blocks on the terminal — a silent, unattributable hang.
# It only bites when the suite runs from a real terminal (a dev's Mac): in Docker/CI
# there is no controlling terminal, so every prompt already takes its non-interactive
# branch and the suite is green — which is exactly why this was invisible for so long.
# CCO_NONINTERACTIVE=1 forces _cco_have_tty() false everywhere, so every prompt takes
# that same non-interactive branch regardless of the launching terminal. Tests that
# specifically exercise interactive prompts unset it themselves.
export CCO_NONINTERACTIVE=1

# Neutralize the ambient cco-SESSION environment so the suite runs host-side by
# default. When `bin/test` is invoked from INSIDE a cco session (self-dev), the
# container exports CCO_CONTAINER_OPERATOR=1 + absolute CCO_{DATA,STATE,CACHE}_HOME
# + PROJECT_NAME/CCO_CCO_ACCESS/… . Those would leak into every `run_cco`, forcing
# operator-shim behavior (`stop is host-only`, scoped output) and, worse, pointing
# test bucket writes at the REAL session state. Tests that WANT operator mode set
# the full env themselves (test_operator_shim, test_access_scope). On the host none
# of these are set, so this is a no-op there.
#
# This list is the same signal family the session descriptor carries, so it is kept in
# step with it by INV-DESC (test_invariant_descriptor_keys_neutralized_in_suite).
# CCO_STORE_TOTALS is why that lint exists: a real value leaking in from a self-dev
# session adds a hidden-count SUPPLEMENT the notice tests never asked for, so three of
# them failed in-container and passed on the host — indistinguishable, from the outside,
# from the known host-only set.
unset CCO_CONTAINER_OPERATOR CCO_IN_CONTAINER \
      CCO_CCO_ACCESS CCO_CLAUDE_ACCESS CCO_SHOW_HOST_PATHS CCO_CONFIG_TARGETS \
      CCO_ACCESS_TRIPLE \
      PROJECT_NAME CCO_PROJECT_PACKS CCO_PROJECT_LLMS CCO_STORE_TOTALS \
      CCO_DATA_HOME CCO_STATE_HOME CCO_CACHE_HOME CCO_CONFIG_DIR \
      CCO_SESSION_CONTEXT CCO_SUBAGENT_CONTEXT 2>/dev/null || true

# ── Colors ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'
    CYAN='\033[0;36m'; RESET='\033[0m'; BOLD='\033[1m'
else
    GREEN=''; RED=''; YELLOW=''; CYAN=''; RESET=''; BOLD=''
fi

# ── State ─────────────────────────────────────────────────────────────
PASS=0; FAIL=0; TOTAL=0
VERBOSE=false
LIST_ONLY=false
FILE_FILTERS=()
NAME_FILTER=""

# ── Parse arguments ──────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose|-v)  VERBOSE=true; shift ;;
        --list)        LIST_ONLY=true; shift ;;
        --file)        FILE_FILTERS+=("$2"); shift 2 ;;   # repeatable: accumulate
        --filter)      NAME_FILTER="$2"; shift 2 ;;
        --help|-h)
            cat <<'EOF'
Usage: bin/test [OPTIONS]

Options:
  --file <name>    Run only tests in tests/<name>.sh (e.g. test_init).
                   Repeatable: pass --file more than once to run several files.
  --filter <sub>   Run only test functions matching substring
  --verbose, -v    Show output from passing tests
  --list           List all test function names without running
EOF
            exit 0
            ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# ── Helpers ──────────────────────────────────────────────────────────
_elapsed_ms() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import time; print(int(time.time()*1000))"
    else
        echo 0
    fi
}

_run_test() {
    local fn_name="$1"
    local file_label="$2"
    local start_ms end_ms elapsed

    start_ms=$(_elapsed_ms)

    local output exit_code=0
    # Run each test in a subshell for isolation; capture output.
    # NOTE: deliberately NO `set -e` inside this subshell. bash 5.x already
    # SUPPRESSES errexit inside `$(( set -e; fn ) )`, so the suite was authored
    # for a context where a non-final non-zero command does NOT abort — negative
    # tests use the idiom `bare_cmd_that_returns_nonzero; rc=$?`. macOS's default
    # bash 3.2 does NOT suppress errexit there: it aborts those tests early with
    # empty output (spurious [FAIL]s). Real failures are caught by the mask-guard
    # below (the ASSERTION-FAILED sentinel grep) plus the test's own final exit
    # code — not by errexit — so behaviour is now identical on bash 3.2 and 5.x.
    # (The separate silent-HANG class — a cco prompt blocking on /dev/tty while its
    # text is swallowed by this very capture — is handled by CCO_NONINTERACTIVE=1,
    # exported at the top of this file; it is not a property of this subshell.)
    output=$(( "$fn_name" ) 2>&1) || exit_code=$?

    # Mask-guard (adherence audit 2026-06-21, HITL-1): under `( set -e; fn )`,
    # a non-final assertion failure is swallowed — a failing `assert_*` (or a
    # `[[ … ]] || fail`) that is not the LAST command leaves exit_code 0, so the
    # mid-test failure passes silently. Every assert/`fail` helper echoes the
    # sentinel "ASSERTION FAILED:"; treat its presence as a failure regardless
    # of exit code so masked failures cannot hide drift. (Inline negative-test
    # echoes always pair with `return 1`, so this never false-positives them.)
    if [[ $exit_code -eq 0 ]] && printf '%s\n' "$output" | grep -qE '^[[:space:]]*ASSERTION FAILED'; then
        exit_code=1
    fi

    end_ms=$(_elapsed_ms)
    elapsed=$(( end_ms - start_ms ))

    TOTAL=$(( TOTAL + 1 ))

    if [[ $exit_code -eq 0 ]]; then
        PASS=$(( PASS + 1 ))
        if $VERBOSE; then
            printf "${GREEN}[PASS]${RESET} %-60s ${CYAN}(%sms)${RESET}\n" "$fn_name" "$elapsed"
            if [[ -n "$output" ]]; then
                echo "$output" | sed 's/^/       /'
            fi
        else
            printf "${GREEN}[PASS]${RESET} %-60s ${CYAN}(%sms)${RESET}\n" "$fn_name" "$elapsed"
        fi
    else
        FAIL=$(( FAIL + 1 ))
        printf "${RED}[FAIL]${RESET} %-60s ${CYAN}(%sms)${RESET}\n" "$fn_name" "$elapsed"
        if [[ -n "$output" ]]; then
            echo "$output" | sed "s/^/       ${RED}│${RESET} /"
        fi
    fi
}

# ── Discovery & Execution ─────────────────────────────────────────────
_discover_and_run() {
    local test_file="$1"
    local file_base
    file_base="$(basename "$test_file" .sh)"

    # Apply file filter. --file is repeatable and ACCUMULATES: with one or more
    # given, run any file whose base matches ANY of them; with none, run all. (Was
    # last-wins, which silently ran only the last named file — testing.md's
    # multi-file Selective-Execution rows depend on this fix.)
    if [[ ${#FILE_FILTERS[@]} -gt 0 ]]; then
        local _ff _matched=false
        for _ff in "${FILE_FILTERS[@]}"; do
            [[ "$file_base" == "$_ff" ]] && { _matched=true; break; }
        done
        $_matched || return 0
    fi

    # Extract function names from file using grep (before sourcing to avoid side-effects)
    local fn_names=()
    while IFS= read -r fn_name; do
        [[ -z "$fn_name" ]] && continue
        # Apply name filter
        if [[ -n "$NAME_FILTER" && "$fn_name" != *"$NAME_FILTER"* ]]; then
            continue
        fi
        fn_names+=("$fn_name")
    done < <(grep -E '^test_[a-zA-Z0-9_]+[[:space:]]*\(\)' "$test_file" | sed 's/[[:space:]]*().*$//')

    if [[ ${#fn_names[@]} -eq 0 ]]; then
        return 0
    fi

    # Source the file (loads helpers + test functions into current shell)
    # shellcheck source=/dev/null
    source "$test_file"

    # Print file header
    if ! $LIST_ONLY; then
        printf "\n${BOLD}${CYAN}── %s ${RESET}\n" "$file_base"
    fi

    for fn_name in "${fn_names[@]}"; do
        if $LIST_ONLY; then
            echo "$fn_name"
        else
            _run_test "$fn_name" "$file_base"
        fi
    done
}

# Source helpers and mocks into parent shell so subshells inherit them
# shellcheck source=tests/helpers.sh
source "$TESTS_DIR/helpers.sh"
# shellcheck source=tests/mocks.sh
source "$TESTS_DIR/mocks.sh"

# Discover and run all test files
for test_file in "$TESTS_DIR"/test_*.sh; do
    [[ -f "$test_file" ]] || continue
    _discover_and_run "$test_file"
done

# ── Summary ───────────────────────────────────────────────────────────
if ! $LIST_ONLY; then
    echo ""
    echo "────────────────────────────────────────────────"
    if [[ $FAIL -eq 0 ]]; then
        printf "${GREEN}${BOLD}Results: %d passed, %d failed, %d total${RESET}\n" "$PASS" "$FAIL" "$TOTAL"
    else
        printf "${RED}${BOLD}Results: %d passed, %d failed, %d total${RESET}\n" "$PASS" "$FAIL" "$TOTAL"
    fi
    echo "────────────────────────────────────────────────"
fi

[[ $FAIL -eq 0 ]]
